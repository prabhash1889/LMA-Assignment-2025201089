# Copy to .env and enter your own key. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
# Use openrouter for API answers, local for an offline Hugging Face LLM,
# or none to run retrieval only. Retrieval-only is NOT a complete submission.
RAG_LLM_BACKEND=openrouter
RAG_LOCAL_LLM=Qwen/Qwen2.5-1.5B-Instruct
RAG_DEVICE=cpu
RAG_BENCHMARK_REPEATS=10
